/**
 * Firestore Security Rules
 * 
 * Deploy these rules to your Firebase project:
 * 1. Go to Firebase Console > Firestore Database > Rules
 * 2. Replace the existing rules with the content below
 * 3. Click "Publish"
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // USER PROFILES
    // Users can read/write only their own profile
    // ============================================
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Users cannot delete their profiles
    }

    // ============================================
    // TEAMS
    // ============================================
    match /teams/{teamId} {
      allow read: if request.auth != null;
      
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      
      allow update: if request.auth != null && (
        // الحالة الأولى: صاحب الفريق يقدر يعدل في فريقه براحته
        resource.data.ownerId == request.auth.uid
        ||
        // الحالة التانية: أي يوزر بيعمل (Join أو Leave) 
        // يُسمح له بالتعديل "فقط" في مصفوفة الأعضاء والتاريخ
        // ومستحيل يقدر يغير صاحب الفريق أو اسم الفريق أو الـ ID
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
      );
      
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // ============================================
    // IDEAS
    // Only team members can read/write ideas
    // ============================================
    match /ideas/{ideaId} {
      // Authenticated users can read ideas (team validation done in app)
      allow read: if request.auth != null;
      
      // Authenticated users can create ideas
      allow create: if request.auth != null
        && request.resource.data.creatorId == request.auth.uid;
      
      // Authenticated users can update ideas (for likes)
      allow update: if request.auth != null;
      
      // Only the creator can delete
      allow delete: if request.auth != null
        && resource.data.creatorId == request.auth.uid;
    }
  }
}
